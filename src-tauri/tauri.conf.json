{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File Atlas",
  "version": "2.0.0",
  "identifier": "com.alkaidynamics.fileatlas",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "File Atlas — Storage Forensics",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
